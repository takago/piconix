+int uptime_device_read(void *dst, size_t capacity, uint32_t *position, uint32_t ticks_ms);
+#endif
diff --git a/userland/apps/labuptime.c b/userland/apps/labuptime.c
new file mode 100644
index 0000000..abe0e76
--- /dev/null
+++ b/userland/apps/labuptime.c
@@ -0,0 +1,17 @@
+/* Compare the new syscall with the new read-only device node. */
+#include "unistd.h"
+#include "fcntl.h"
+#include "stdio.h"
+
+int main(void) {
+    printf("getuptime: %u ms\n", getuptime());
+    int fd = open("/dev/uptime", O_RDONLY);
+    if (fd < 0) { printf("open: %d\n", fd); return 1; }
+    char bytes[8];
+    int n;
+    while ((n = read(fd, bytes, sizeof bytes)) > 0) {
+        if (write(1, bytes, (unsigned)n) < 0) break;
+    }
+    close(fd);
+    return n < 0 ? 1 : 0;
+}
